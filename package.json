{
  "name": "switch-kpi",
  "version": "0.1.2",
  "description": "PCC live ATEM source, transition, award and show-report analytics.",
  "author": "PCC",
  "private": true,
  "main": "desktop/main.mjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node monitor/start.mjs",
    "monitor": "node monitor/start.mjs",
    "dev:dashboard": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev --host 0.0.0.0",
    "start:dashboard": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "desktop": "electron desktop/main.mjs",
    "package:mac": "npm run build && electron-builder --mac dmg --arm64",
    "package:win": "npm run build && electron-builder --win zip --x64",
    "package:desktop": "npm run build && electron-builder --mac dmg --arm64 && electron-builder --win zip --x64",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "atem-connection": "^3.9.0",
    "jpeg-js": "^0.4.4",
    "pdfkit": "0.19.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-orm": "0.45.2",
    "drizzle-kit": "0.31.10",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-loading-skeleton": "3.5.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0",
    "electron": "43.1.1",
    "electron-builder": "26.15.3"
  },
  "type": "module",
  "build": {
    "appId": "au.com.pcces.switchkpi",
    "productName": "Switch KPI",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "desktop/**/*",
      "monitor/**/*",
      "dist/standalone/**/*",
      "build/icon.png",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "zip"
      ]
    }
  }
}
